# ============================================================
# LLM Provider (태깅 및 자료 생성에 사용)
# ============================================================
# "ollama" 또는 "openai"
AI_PROVIDER=ollama

# Ollama 설정 (AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:4b
# 한국어 지원 모델 대안: qwen2.5:7b, qwen2.5:14b, exaone3.5:7.8b

# OpenAI 설정 (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# ============================================================
# document_agent 전용 설정
# ============================================================
# 생성된 자료 저장 경로
MATERIALS_DIR=./generated_materials

# LLM 동시 호출 수 (Ollama: 3-5, OpenAI: 5-10 권장)
LLM_TAG_CONCURRENCY=5
LLM_GEN_CONCURRENCY=3

# LLM 재시도 설정
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE=2

# 마인드맵 생성 여부 (LLM 없이 태그 집계로 생성)
GENERATE_MIND_MAP=false

# LLM 온도 (낮을수록 구조화된 출력)
LLM_TAG_TEMPERATURE=0.2
LLM_GEN_TEMPERATURE=0.4

# ============================================================
# 서버 설정
# ============================================================
API_HOST=0.0.0.0
API_PORT=8001
