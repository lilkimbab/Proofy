APP_STORAGE_BACKEND=memory
APP_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL 사용 시 예시
# APP_STORAGE_BACKEND=postgres
# APP_DATABASE_URL=postgresql://proofy:proofy@localhost:5432/proofy


APP_LLM_PROVIDER=gemini
APP_CONTENT_GENERATION_PROVIDER=gemini
APP_GEMINI_MODEL=gemini-3.8-flash
APP_GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Gemini가 바쁘거나(503) 무료 한도를 넘으면 자동으로 쓰는 예비 LLM (OpenAI 호환, 예: Groq)
APP_LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
APP_LLM_API_KEY=YOUR_GROQ_API_KEY
APP_LLM_MODEL=openai/gpt-oss-120b
APP_CONTENT_GENERATION_API_URL=https://api.groq.com/openai/v1/chat/completions
APP_CONTENT_GENERATION_API_KEY=YOUR_GROQ_API_KEY
APP_CONTENT_GENERATION_MODEL=openai/gpt-oss-120b
