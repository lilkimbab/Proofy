# Zero-cost local functional testing profile.
# This profile does not call OpenAI or the team Search Agent.

DATABASE_URL=sqlite+pysqlite:///./study_agent_free.db
SEARCH_AGENT_URL=
DEMO_SEARCH_ENABLED=true
OPENAI_API_KEY=
LLM_FALLBACK_ENABLED=true

# Model names are kept for compatibility but are not used while fallback mode is active.
EMBEDDING_MODEL=text-embedding-3-small
PROBLEM_MODEL=local-deterministic
PROBLEM_QUALITY_MODEL=local-deterministic
LEARNING_CONTENT_MODEL=local-deterministic
LEARNING_CONTENT_QUALITY_MODEL=local-deterministic
FEEDBACK_MODEL=local-deterministic
GRADING_MODEL=local-deterministic
GRADING_QUALITY_MODEL=local-deterministic
MULTIPLE_CHOICE_FEEDBACK_LLM_ENABLED=false

LLM_CHUNK_CHAR_LIMIT=1800
LLM_MAX_OUTPUT_TOKENS_PROBLEM=2500
LLM_MAX_OUTPUT_TOKENS_LEARNING_CONTENT=1800
LLM_MAX_OUTPUT_TOKENS_FEEDBACK=900
LLM_REASONING_EFFORT_PROBLEM=low
LLM_REASONING_EFFORT_LEARNING_CONTENT=low
LLM_REASONING_EFFORT_FEEDBACK=low
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=0

AUTO_CREATE_TABLES=true
