# ============================================================
# Supabase 연결 (서비스 롤 키 사용 — user_id로 직접 필터링)
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# ============================================================
# LLM Provider (document_agent와 동일 패턴)
# ============================================================
# "ollama" 또는 "openai"
AI_PROVIDER=ollama

# Ollama 설정
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma3:4b
# 한국어 지원 대안: qwen2.5:7b, llama3.2:3b

# OpenAI 설정 (AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# LLM 설정
LLM_TEMPERATURE=0.3
LLM_MAX_RETRIES=3
LLM_RETRY_BACKOFF_BASE=2

# ============================================================
# 데이터 경로
# ============================================================
ROADMAP_DIR=./roadmaps
DOCUMENT_AGENT_MATERIALS_DIR=../document_agent/generated_materials
RAG_AGENT_USER_PROFILE_DIR=../rag_agent/user_profiles

# ============================================================
# 로드맵 설정
# ============================================================
# 일일 학습 목표 시간 (분)
DEFAULT_DAILY_STUDY_MINUTES=30
# 일별 계획 최대 일수
MAX_DAILY_PLAN_DAYS=30

# ============================================================
# 서버 설정
# ============================================================
API_HOST=0.0.0.0
API_PORT=8002
