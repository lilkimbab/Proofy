# Vector DB 저장 경로 (LanceDB)
LANCEDB_PATH=./lancedb_store

# 임베딩 모델 선택: "local" (BAAI/bge-m3) 또는 "openai"
EMBED_MODEL=local
# encode() 내부 배치 크기. 클수록 빠름 (CPU BLAS 효율). GPU 8GB: 256, GPU 16GB+: 512
EMBED_ENCODE_BATCH_SIZE=256
# embed-DB producer-consumer 큐 크기. GPU 전환 시 4~8로 증가 (embed가 DB보다 빨라질수록 효과)
EMBED_QUEUE_SIZE=1

# OpenAI 임베딩 사용 시 필요 (EMBED_MODEL=openai 일 때만)
OPENAI_API_KEY=

# 검색 기본값
TOP_K=5

# Search mode: "hybrid" (default), "vector", "fts"
SEARCH_MODE=hybrid
# RRF constant (논문 기본 60)
RRF_K=60
# 후보 multiplier: top_k * MULTIPLIER 만큼 각 검색기에서 후보 추출
CANDIDATE_MULTIPLIER=4

# Reranker (BAAI/bge-reranker-v2-m3) 사용 여부
RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 1차 검색에서 top_k * MULTIPLIER 만큼 후보 추출 후 rerank
RERANK_CANDIDATE_MULTIPLIER=4

# 청킹 설정
CHUNK_SIZE=512
CHUNK_OVERLAP=64
# Chunking 전략: "structural" (기본, markdown 구조 우선) 또는 "fixed" (고정 크기 only)
CHUNK_STRATEGY=structural
# 1차 구조 분할 후 병합 임계값 (글자 수)
MIN_CHUNK_CHARS=200

# ─── 터널 설정 ─────────────────────────────────────────────
# 외부 접속 방식: "none" (로컬 전용) | "ngrok"
TUNNEL_BACKEND=none
# ngrok 사용 시: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTH_TOKEN=
# ngrok 리전: ap (아시아-태평양), us, eu, au, sa, jp, in
NGROK_REGION=ap

# ─── API 서버 ───────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ─── 이미지 처리 ────────────────────────────────────────────
IMAGE_STORE_PATH=./image_store
# 래스터 이미지 감지 최소 엣지 크기 (픽셀)
IMAGE_MIN_EDGE=32
# 크롭 면적이 페이지 면적의 이 비율 미만이면 장식용 이미지로 스킵
CROP_MIN_AREA_RATIO=0.02
# 크롭 bbox가 표 bbox와 이 비율 이상 겹치면 표 내부 이미지로 스킵
CROP_TABLE_OVERLAP_THRESHOLD=0.70
# 벡터 드로잉 감지 (2단계용, 현재 미구현)
MIN_DRAWING_COUNT=5
MIN_DRAWING_AREA_RATIO=0.10
# 벡터 클러스터링 gap 임계값, 최소 면적 비율 (2단계용, 현재 미구현)
DRAWING_CLUSTER_GAP_PX=15
DRAWING_MIN_AREA_RATIO=0.03

# ─── OCR ────────────────────────────────────────────────────
# 스캔 PDF(이미지 전용 페이지) 텍스트 추출 방식
# "none": OCR 비활성 (기본값, 스캔 페이지 텍스트는 빈 문자열)
# "easyocr": EasyOCR 사용 (pip install easyocr, PyTorch 재사용)
OCR_PROVIDER=none
# EasyOCR 인식 언어 (쉼표 구분, OCR_PROVIDER=easyocr 시 유효)
OCR_LANGUAGES=ko,en
# 이 글자 수 미만이면서 대형 래스터가 있는 페이지 → 스캔으로 판단
OCR_SCANNED_TEXT_THRESHOLD=50
# 페이지 면적 대비 이 비율 이상을 차지하는 래스터 → 스캔 후보
OCR_SCANNED_COVERAGE_RATIO=0.5
# OCR용 렌더링 배율 (2.0 = 144dpi)
OCR_RENDER_SCALE=2.0

# Personalization
PERSONALIZATION_ENABLED=true
USER_PROFILE_DIR=./user_profiles
USER_QUERY_HISTORY_MAX=200
PERSONAL_VIEW_WEIGHT=0.05
PERSONAL_USEFUL_WEIGHT=0.15
PERSONAL_MAX_BOOST=1.5
