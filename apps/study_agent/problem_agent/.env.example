# Runtime DB. Local demo can use sqlite+pysqlite:///./study_agent.db.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/study_agent

# Team-owned Search Agent base URL. Required when DEMO_SEARCH_ENABLED=false.
SEARCH_AGENT_URL=http://localhost:8001
SEARCH_AGENT_API_KEY=
SEARCH_AGENT_API_KEY_HEADER=X-API-Key
# Increase when the RAG server does reranking or returns large image payloads.
SEARCH_AGENT_TIMEOUT_SECONDS=20

# 김태훈 RAG Agent를 그대로 붙일 때 사용한다.
# 설정하면 SEARCH_AGENT_URL보다 우선한다. RAG Agent 기본 포트가 8000이면
# Problem Agent FastAPI와 포트가 겹치지 않도록 한쪽 포트를 바꿔야 한다.
# RAG_AGENT_URL=http://localhost:8000
# RAG endpoint paths can be changed without touching code if the integrated server uses a prefix.
RAG_AGENT_SEARCH_PATH=/search
# Leave empty when the RAG server does not expose chunk batch lookup. The adapter will use cached search chunks.
RAG_AGENT_CHUNKS_PATH=
# 김태훈 RAG Agent의 /fetch를 chunk 재조회 경로로 쓴다. /chunks/batch가 있으면 그 설정이 우선한다.
RAG_AGENT_FETCH_PATH=/fetch
# Problem generation uses text chunks only. The adapter also sends X-RAG-Text-Only: true.
RAG_AGENT_TEXT_ONLY=true
# Set true only for ngrok-hosted RAG servers that require this bypass header.
RAG_AGENT_SKIP_NGROK_WARNING=false
# Compatibility fallback only. The integrated pipeline is text-only.
RAG_AGENT_PRESERVE_IMAGE_PAYLOADS=false
# Live RAG smoke test only. Used by: pytest -m rag tests/test_rag_agent_live_smoke.py
RAG_SMOKE_DOCUMENT_ID=demo_doc
RAG_SMOKE_QUERY=핵심 개념을 문제로 만들 수 있는 문단을 찾아줘
RAG_SMOKE_CONCEPT=핵심 개념

# Local-only mode with built-in demo chunks. Keep false in production.
DEMO_SEARCH_ENABLED=false

# Optional outbound publisher for generated problems/feedback.
# 김태훈 Vector DB 쪽에서 제공하는 색인 API의 전체 URL을 넣는다.
# 기본값은 비활성화라 로컬 테스트에서는 아무 것도 전송하지 않는다.
# 예: http://localhost:8001/generated-artifacts/index
GENERATED_ARTIFACT_INDEX_URL=
# RAG Agent /add multipart smoke 전송용. 정식 JSON 색인 API가 없을 때만 테스트로 사용한다.
# 예: http://localhost:8000/add
GENERATED_ARTIFACT_ADD_URL=
GENERATED_ARTIFACT_ADD_TITLE_PREFIX=generated_artifact
GENERATED_PROBLEM_RAG_UPLOAD_ENABLED=true
GENERATED_PROBLEM_RAG_ADD_PATH=/add
GENERATED_ARTIFACT_PUBLISH_ENABLED=false
GENERATED_ARTIFACT_PUBLISH_FAIL_FAST=false
GENERATED_ARTIFACT_API_KEY=
GENERATED_ARTIFACT_API_KEY_HEADER=X-API-Key
GENERATED_ARTIFACT_TIMEOUT_SECONDS=3
GENERATED_ARTIFACT_PUBLISH_CONCURRENCY=4
# Live generated artifact smoke test only. This writes one smoke artifact.
# Used by: pytest -m rag tests/test_generated_artifact_live_smoke.py
GENERATED_ARTIFACT_SMOKE_ENABLED=false
GENERATED_ARTIFACT_SMOKE_USER_ID=smoke_user_001
GENERATED_ARTIFACT_SMOKE_DOCUMENT_ID=smoke_doc_001
GENERATED_ARTIFACT_SMOKE_CHUNK_ID=smoke_chunk_001
GENERATED_ARTIFACT_SMOKE_PROBLEM_ID=smoke_prob_001

# Live problem-agent E2E smoke test only. This calls RAG and writes generated artifacts.
# Used by: pytest -m rag tests/test_problem_agent_live_e2e_smoke.py
PROBLEM_AGENT_E2E_SMOKE_ENABLED=false
PROBLEM_AGENT_E2E_SMOKE_USER_ID=smoke_user_001
PROBLEM_AGENT_E2E_SMOKE_DOCUMENT_ID=demo_doc
PROBLEM_AGENT_E2E_SMOKE_CONCEPT=핵심 개념
# Set true only when you want the live E2E smoke test to call OpenAI too.
PROBLEM_AGENT_E2E_SMOKE_USE_OPENAI=false

# Required in production for LLM problem generation and short-answer grading.
LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Live OpenAI smoke test model overrides. Used by: pytest -m llm tests/test_openai_smoke_llm.py
OPENAI_SMOKE_PROBLEM_MODEL=gpt-5.4-mini
OPENAI_SMOKE_GRADING_MODEL=gpt-5.4-mini

# Local/test-only deterministic fallback. Keep false in production.
LLM_FALLBACK_ENABLED=false

# Search embedding model is owned by DB/Search team; this is the expected default.
EMBEDDING_MODEL=text-embedding-3-small

# Cost-aware model routing for problem generation and feedback.
PROBLEM_MODEL=gpt-5.4-mini
PROBLEM_QUALITY_MODEL=gpt-5.5
PROBLEM_AGENT_COST_PROFILE=balanced
PROBLEM_AGENT_ALLOW_PREMIUM_ESCALATION=false
PROBLEM_AGENT_PROMPT_COMPRESSION_ENABLED=true
PROBLEM_AGENT_EVIDENCE_PACK_MAX_ATOMS=6
PROBLEM_AGENT_EVIDENCE_PACK_MAX_QUOTE_CHARS=420
PROBLEM_AGENT_CONTEXT_RAW_CHUNK_MAX_CHARS=700
PROBLEM_AGENT_INCLUDE_MCQ_FEWSHOTS_IN_CHEAP=false
# Live eval rejected candidate export. Default redacts answer/explanation/rubric.
PROBLEM_AGENT_LIVE_EVAL_REJECTED_CANDIDATE_EXPORT_MODE=redacted
# Leave empty for profile default: cheap/balanced=single_then_repair, full=batch_candidates.
PROBLEM_AGENT_GENERATION_STRATEGY=
LEARNING_CONTENT_MODEL=gpt-5.4-mini
LEARNING_CONTENT_QUALITY_MODEL=gpt-5.5
FEEDBACK_MODEL=gpt-5.4-nano
GRADING_MODEL=gpt-5.4-mini
GRADING_QUALITY_MODEL=gpt-5.5

# Keep false to avoid LLM cost for deterministic multiple-choice feedback.
MULTIPLE_CHOICE_FEEDBACK_LLM_ENABLED=false

# Token/cost controls.
LLM_CHUNK_CHAR_LIMIT=1800
LLM_MAX_OUTPUT_TOKENS_PROBLEM=2500
LLM_MAX_OUTPUT_TOKENS_LEARNING_CONTENT=1800
LLM_MAX_OUTPUT_TOKENS_FEEDBACK=900
LLM_REASONING_EFFORT_PROBLEM=low
LLM_REASONING_EFFORT_PROBLEM_QUALITY=medium
LLM_REASONING_EFFORT_LEARNING_CONTENT=low
LLM_REASONING_EFFORT_FEEDBACK=low
LLM_GEMINI_HIGH_RIGOR_CANDIDATE_MULTIPLIER=1
PROBLEM_AGENT_HIGH_RIGOR_MCQ_MIN_CANDIDATES=3
PROBLEM_AGENT_HIGH_RIGOR_MCQ_RETRY_COUNT=2
PROBLEM_AGENT_SEARCH_QUERY_MODE=compact
PROBLEM_AGENT_GENERATION_CONTEXT_PACKING_ENABLED=true
PROBLEM_AGENT_GENERATION_CONTEXT_MAX_CHUNKS=8
PROBLEM_AGENT_GENERATION_CONTEXT_MIN_CHUNKS=3
PROBLEM_AGENT_USE_DOMAIN_GENERAL_KERNELS=true
PROBLEM_AGENT_ALLOW_STANDARD_FALLBACK_ON_KERNEL_FAILURE=false
# Optional independent answer-correctness verification. Keep disabled for normal generation.
PROBLEM_AGENT_ANSWER_VERIFICATION_ENABLED=false
PROBLEM_AGENT_ANSWER_VERIFICATION_LLM_ENABLED=false
PROBLEM_AGENT_ANSWER_VERIFICATION_MODEL=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1

# Optional cost estimation. Keep 0 until the team fills in the current API prices.
LLM_STANDARD_INPUT_PRICE_KRW_PER_1M_TOKENS=0
LLM_STANDARD_OUTPUT_PRICE_KRW_PER_1M_TOKENS=0
LLM_PREMIUM_INPUT_PRICE_KRW_PER_1M_TOKENS=0
LLM_PREMIUM_OUTPUT_PRICE_KRW_PER_1M_TOKENS=0
LLM_MONTHLY_USER_BUDGET_KRW=0
LLM_BUDGET_WARNING_RATIO=0.8
LLM_ENFORCE_MONTHLY_BUDGET=false
PROBLEM_GENERATION_MONTHLY_LIMIT=0
PROBLEM_GENERATION_HIGH_RIGOR_MONTHLY_LIMIT=0

# Local SQLite demo only. PostgreSQL startup create_all is rejected; production storage should use Kim Tae-hoon's DB/Vector DB integration.
AUTO_CREATE_TABLES=false
